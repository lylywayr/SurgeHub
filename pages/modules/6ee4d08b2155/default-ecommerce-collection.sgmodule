[Rule]
# 京东去广告
{{{京东去广告}}}URL-REGEX,"^http:\/\/\w{32}\.jddebug\.com\/diagnose\?",REJECT
# 拼多多去广告
{{{拼多多去广告}}}AND,((URL-REGEX,"^http:\/\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\/d(\d)?"),(USER-AGENT,"*com.xunmeng.pinduoduo*")),REJECT
{{{拼多多去广告}}}AND,((URL-REGEX,"^http:\/\/\[[0-9a-fA-F:]+\]\/d(\d)?\?"),(USER-AGENT,"*com.xunmeng.pinduoduo*")),REJECT
{{{拼多多去广告}}}AND,((DOMAIN,api.pinduoduo.com),(PROTOCOL,QUIC)),REJECT
